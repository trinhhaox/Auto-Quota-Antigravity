{
  "name": "auto-quota-antigravity",
  "displayName": "Aquota",
  "description": "Real-time AI Quota Monitor for Antigravity IDE, Claude Code, and OpenAI Codex.",
  "version": "2.0.0",
  "publisher": "BiViPi",
  "author": {
    "name": "BiViPi",
    "url": "https://github.com/BiViPi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trinhhaox/Auto-Quota-Antigravity.git"
  },
  "icon": "logo/logo.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqm-explorer",
          "title": "Aquota",
          "icon": "$(dashboard)"
        }
      ]
    },
    "views": {
      "sqm-explorer": [
        {
          "type": "webview",
          "id": "sqm.sidebar",
          "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "sqm.refresh",
        "title": "Aquota: Refresh Quotas",
        "icon": "$(refresh)"
      },
      {
        "command": "sqm.menu",
        "title": "Aquota: Quick Menu"
      }
    ],
    "configuration": {
      "title": "Aquota",
      "properties": {
        "sqm.refreshInterval": {
          "type": "number",
          "default": 5,
          "enum": [
            1,
            2,
            5,
            10,
            15,
            30
          ],
          "description": "Auto-refresh interval in minutes (default is 5)"
        },
        "sqm.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Enable notifications for low quotas"
        },
        "sqm.notifyThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 90,
          "description": "Notify when remaining quota drops to this percentage."
        },
        "sqm.statusBar.mode": {
          "type": "string",
          "enum": [
            "full",
            "compact",
            "dot"
          ],
          "default": "full",
          "description": "Status bar display: full = all groups, compact = worst group only, dot = single colored dot."
        },
        "sqm.claude.usagePeriod": {
          "type": "string",
          "enum": [
            "5-hour",
            "7-day",
            "both"
          ],
          "default": "both",
          "description": "Which Claude.ai usage windows to display in the dashboard."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "typescript": "^5.7.2",
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.2.1"
  }
}
